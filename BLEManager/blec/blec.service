[Unit]
Description=MV999 BLE Daemon (btstack C)
After=network.target
Conflicts=bluetooth.service ble-server.service ble-watchdog.service debug-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/hciconfig hci0 down
ExecStart=/home/gps/blec/ble_daemon
Restart=always
RestartSec=3
TimeoutStopSec=10
User=root

[Install]
WantedBy=multi-user.target
